PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?item ?form ?ordinal ?label ?alias ?composer WHERE {
  ?item wdt:P86 ?composer; wdt:P7937 ?form; p:P179 ?seriesStatement.
  ?seriesStatement pq:P1545 ?ordinal.
  ?item rdfs:label ?label.
  FILTER(LANG(?label) IN ("en","it","fr","de","es","pt","nl"))
  OPTIONAL { ?item skos:altLabel ?alias. FILTER(LANG(?alias)=LANG(?label)) }
}