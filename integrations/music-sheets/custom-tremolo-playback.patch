+package com.musicsheets.app.playback;
+
+import com.musicsheets.app.pdf.*;
+import java.util.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Original source records and actual scheduler/navigation/custom-instrument entry points. */
+public class CustomInstrumentTremoloRetentionTest {
+    private SheetInterpreterAudio.RenderSpec source() {
+        var notes = List.of(note(.15f, 0, false, 2), note(.65f, 4, false, 2));
+        return new SheetInterpreterAudio.RenderSpec(notes, 1, 120, 4, "Piano", "C Major")
+                .withTremoloSource(pair(notes.size(), 0, 1));
+    }
+
+    private ScoreNoteEvent note(float x, int pitch, boolean tied, float duration) {
+        return new ScoreNoteEvent(0, x, pitch, 0, 1, .4f, tied, 0, 0, 0, duration)
+                .withClef(ScoreNoteEvent.CLEF_TREBLE);
+    }
+
+    private ScoreTremoloSource pair(int count, int first, int second) {
+        var pair =
+                new ScoreTremoloSource.Pair(
+                        "original-pair",
+                        List.of(new ScoreTremoloSource.Anchor(0, first)),
+                        List.of(new ScoreTremoloSource.Anchor(0, second)),
+                        3,
+                        List.of(new ScoreTremoloSource.Evidence(0, .2f, .3f, .6f, .4f)));
+        return ScoreTremoloSource.capture(0, count, List.of(pair));
+    }
+
+    private SheetInterpreterAudio.RenderSpec projected(
+            SheetInterpreterAudio.RenderSpec spec, boolean repeat) {
+        var directions =
+                repeat
+                        ? List.of(
+                                new ScorePlaybackDirection(
+                                        0, ScorePlaybackDirection.Kind.REPEAT_START),
+                                new ScorePlaybackDirection(
+                                        1, ScorePlaybackDirection.Kind.REPEAT_END))
+                        : List.<ScorePlaybackDirection>of();
+        return SheetInterpreterNavigation.prepare(
+                        spec,
+                        ScoreNavigationPlan.create(1, directions),
+                        (s, p, t) -> new SheetInterpreterNavigation.Gains(List.of(), Map.of()),
+                        ScoreNavigationNoteProjection.EntryPolicy.REATTACK)
+                .spec();
+    }
+
+    private List<SheetInterpreterAudio.Tone> tones(SheetInterpreterAudio.RenderSpec spec) {
+        return SheetInterpreterAudio.scheduledTones(spec, SheetInterpreterAudio.SAMPLE_RATE * 8L);
+    }
+
+    private void sameSchedule(
+            List<SheetInterpreterAudio.Tone> before,
+            List<SheetInterpreterAudio.Tone> after,
+            double multiplier) {
+        assertEquals(before.size(), after.size());
+        for (int i = 0; i < before.size(); i++) {
+            assertEquals(before.get(i).startFrame(), after.get(i).startFrame());
+            assertEquals(before.get(i).endFrame(), after.get(i).endFrame());
+            assertEquals(before.get(i).frequency() * multiplier, after.get(i).frequency(), 1e-9);
+        }
+    }
+
+    @Test
+    public void defaultUnprojectedSelectionRetainsAlternatingAttacks() {
+        var input = source();
+        assertEquals(12, tones(input).size());
+        sameSchedule(tones(input), tones(CustomInstrumentPlayback.apply(input, new int[3][2])), 1);
+    }
+
+    @Test
+    public void shiftedUnprojectedSelectionRetainsPairAndTiming() {
+        var input = source();
+        sameSchedule(
+                tones(input),
+                tones(CustomInstrumentPlayback.apply(input, new int[][] {{1, 0}, {0, 0}, {0, 0}})),
+                2);
+    }
+
+    @Test
+    public void defaultProjectedSelectionRetainsAlternatingAttacks() {
+        var input = projected(source(), false);
+        assertEquals(12, tones(input).size());
+        sameSchedule(tones(input), tones(CustomInstrumentPlayback.apply(input, new int[3][2])), 1);
+    }
+
+    @Test
+    public void repeatedProjectedSelectionRetainsEveryOccurrence() {
+        var input = projected(source(), true);
+        assertEquals(24, tones(input).size());
+        sameSchedule(tones(input), tones(CustomInstrumentPlayback.apply(input, new int[3][2])), 1);
+    }
+
+    @Test
+    public void transpositionMayDifferBetweenRepeatedOccurrences() {
+        var input =
+                projected(source(), true)
+                        .withRows(
+                                new RowPlayback.Config(
+                                        true,
+                                        0,
+                                        List.of(
+                                                new RowPlayback.Rule(
+                                                        0, 1, 2, -1, InterpreterVoice.PIANO, 1))));
+        var before = tones(input);
+        var after =
+                tones(CustomInstrumentPlayback.apply(input, new int[][] {{1, 0}, {0, 0}, {0, 0}}));
+        assertEquals(24, before.size());
+        assertEquals(before.size(), after.size());
+        for (int i = 0; i < before.size(); i++) {
+            assertEquals(before.get(i).startFrame(), after.get(i).startFrame());
+            assertEquals(before.get(i).endFrame(), after.get(i).endFrame());
+            assertEquals(
+                    before.get(i).frequency() * (i < 12 ? 2 : 1), after.get(i).frequency(), 1e-9);
+        }
+    }
+
+    @Test
+    public void tiedOrdinarySoundCanReduceSelectedCountWithoutReassigningPairOrigins() {
+        var notes =
+                List.of(
+                        note(.05f, 0, false, 1),
+                        note(.3f, 0, true, 1),
+                        note(.55f, 2, false, 2),
+                        note(.8f, 5, false, 2));
+        var input =
+                projected(
+                        new SheetInterpreterAudio.RenderSpec(notes, 1, 120, 4, "Piano", "C Major")
+                                .withTremoloSource(pair(4, 2, 3)),
+                        false);
+        assertTrue(input.performanceTiming().performedNotes().size() < input.notes().size());
+        assertTrue(tones(input).size() > 3);
+        sameSchedule(tones(input), tones(CustomInstrumentPlayback.apply(input, new int[3][2])), 1);
+    }
+
+    @Test
+    public void boundaryCopyDoesNotErasePrintedPairIdentity() {
+        var input = source();
+        var copy = input.withBoundaryQuarterBeats(4, 4);
+        assertEquals(input.tremoloSource(), copy.tremoloSource());
+        sameSchedule(tones(input), tones(copy), 1);
+    }
+
+    @Test
+    public void ordinaryNoPairScheduleRemainsExact() {
+        var input =
+                projected(
+                        new SheetInterpreterAudio.RenderSpec(
+                                source().notes(), 1, 120, 4, "Piano", "C Major"),
+                        true);
+        assertEquals(tones(input), tones(CustomInstrumentPlayback.apply(input, new int[3][2])));
+    }
+
+    @Test
+    public void exportAndPlaybackOptionCopiesRetainTheOriginalSoundDomain() throws Exception {
+        var selected = CustomInstrumentPlayback.apply(projected(source(), true), new int[3][2]);
+        assertNotNull(selected.performedTremoloSource());
+        var copies =
+                List.of(
+                        selected.withExactSourceBoundary(new ScoreBoundaryClock(4, 4)),
+                        selected.withPerformanceTiming(selected.performanceTiming()),
+                        selected.withRows(selected.rows()),
+                        selected.withRecordingIdentity("export-copy"),
+                        selected.withSolo(false, selected.soloVoice()),
+                        selected.withSoloGain(selected.soloGain()),
+                        selected.withSecondSolo(
+                                false, selected.secondSoloVoice(), selected.secondSoloGain()),
+                        selected.withOpeningQuarterBeats(selected.openingQuarterBeats()),
+                        selected.withBoundaryQuarterBeats(
+                                selected.openingQuarterBeats(), selected.closingQuarterBeats()),
+                        selected.withSourcePlacements(selected.sourcePlacements()),
+                        selected.withTremoloSource(selected.tremoloSource()),
+                        selected.withDynamics(selected.dynamicChanges()),
+                        selected.withTechniques(selected.techniqueChanges()),
+                        selected.withVoice(selected.voice()));
+        assertEquals(14, copies.size());
+        for (var copy : copies) {
+            assertSame(selected.performedTremoloSource(), copy.performedTremoloSource());
+            assertEquals(24, tones(copy).size());
+        }
+        var method =
+                SheetInterpreterAudio.class.getDeclaredMethod(
+                        "validatedForWrite", SheetInterpreterAudio.RenderSpec.class);
+        method.setAccessible(true);
+        var prepared = (SheetInterpreterAudio.RenderSpec) method.invoke(null, selected);
+        assertSame(selected.performedTremoloSource(), prepared.performedTremoloSource());
+        sameSchedule(tones(selected), tones(prepared), 1);
+    }
+
+    @Test
+    public void originalFullConstructorRemainsCompatible() throws Exception {
+        var input = source();
+        var components = SheetInterpreterAudio.RenderSpec.class.getRecordComponents();
+        Class<?>[] types = new Class<?>[26];
+        Object[] values = new Object[26];
+        for (int i = 0; i < 26; i++) {
+            types[i] = components[i].getType();
+            values[i] = components[i].getAccessor().invoke(input);
+        }
+        var copy =
+                SheetInterpreterAudio.RenderSpec.class
+                        .getDeclaredConstructor(types)
+                        .newInstance(values);
+        assertEquals(input, copy);
+        sameSchedule(tones(input), tones(copy), 1);
+    }
+
+    @Test
+    public void sourceDomainParticipatesInCacheIdentity() throws Exception {
+        var selected = CustomInstrumentPlayback.apply(projected(source(), true), new int[3][2]);
+        var components = SheetInterpreterAudio.RenderSpec.class.getRecordComponents();
+        Class<?>[] types = new Class<?>[26];
+        Object[] values = new Object[26];
+        for (int i = 0; i < 26; i++) {
+            types[i] = components[i].getType();
+            values[i] = components[i].getAccessor().invoke(selected);
+        }
+        var without =
+                SheetInterpreterAudio.RenderSpec.class
+                        .getDeclaredConstructor(types)
+                        .newInstance(values);
+        assertNotEquals(
+                InterpreterAudioIdentity.variant(without),
+                InterpreterAudioIdentity.variant(selected));
+    }
+
+    @Test
+    public void writeNormalizesWithoutDroppingThePerformedPair() throws Exception {
+        var input = projected(source(), true);
+        var selected = CustomInstrumentPlayback.apply(input, new int[3][2]);
+        var directory = java.nio.file.Files.createTempDirectory("tremolo-pcm-");
+        try {
+            var original = directory.resolve("original.wav");
+            var custom = directory.resolve("custom.wav");
+            SheetInterpreterAudio.write(original.toFile(), input);
+            SheetInterpreterAudio.write(custom.toFile(), selected);
+            assertArrayEquals(
+                    java.nio.file.Files.readAllBytes(original),
+                    java.nio.file.Files.readAllBytes(custom));
+        } finally {
+            try (var files = java.nio.file.Files.list(directory)) {
+                for (var file : files.toList()) java.nio.file.Files.delete(file);
+            }
+            java.nio.file.Files.delete(directory);
+        }
+    }
+}
