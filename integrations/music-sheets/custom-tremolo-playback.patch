+package com.musicsheets.app.playback;
+
+import com.musicsheets.app.pdf.*;
+import java.util.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Independent generated tie compression with ordinary rows after the pair. */
+public final class PerformedTremoloNamespaceReviewTest {
+    static ScoreNoteEvent n(int measure, float x, int pitch, boolean tie, float duration) {
+        return new ScoreNoteEvent(measure, x, pitch, 0, 1, .4f, tie, 0, 0, 0, duration)
+                .withClef(ScoreNoteEvent.CLEF_TREBLE);
+    }
+
+    static SheetInterpreterAudio.RenderSpec input() {
+        var notes =
+                List.of(
+                        n(0, .1f, 0, false, 1),
+                        n(0, .3f, 0, true, 1),
+                        n(0, .5f, 0, true, 1),
+                        n(0, .7f, 0, true, 1),
+                        n(1, .15f, 2, false, 2),
+                        n(1, .65f, 5, false, 2),
+                        n(2, .15f, 7, false, 2),
+                        n(2, .65f, 9, false, 2));
+        var pair =
+                new ScoreTremoloSource.Pair(
+                        "review-pair",
+                        List.of(new ScoreTremoloSource.Anchor(0, 4)),
+                        List.of(new ScoreTremoloSource.Anchor(0, 5)),
+                        3,
+                        List.of(new ScoreTremoloSource.Evidence(0, .2f, .3f, .6f, .4f)));
+        var source =
+                new SheetInterpreterAudio.RenderSpec(notes, 3, 120, 4, "Piano", "C Major")
+                        .withTremoloSource(
+                                ScoreTremoloSource.capture(0, notes.size(), List.of(pair)));
+        return SheetInterpreterNavigation.prepare(
+                        source,
+                        ScoreNavigationPlan.create(3, List.of()),
+                        (s, p, t) -> new SheetInterpreterNavigation.Gains(List.of(), Map.of()),
+                        ScoreNavigationNoteProjection.EntryPolicy.REATTACK)
+                .spec();
+    }
+
+    @Test
+    public void compressedOrdinaryPerformedIndexCannotBecomeAnOriginalPairAnchor() {
+        var source = input();
+        assertEquals(8, source.notes().size());
+        assertEquals(5, source.performanceTiming().performedNotes().size());
+        var before =
+                SheetInterpreterAudio.scheduledTones(
+                        source, SheetInterpreterAudio.SAMPLE_RATE * 12L);
+        assertEquals(15, before.size());
+        var changed = CustomInstrumentPlayback.apply(source, new int[3][2]);
+        assertEquals(5, changed.notes().size());
+        var ordinary = changed.performanceTiming().sourceSounds().get(4);
+        assertEquals(List.of(7), ordinary.sourceIndices());
+        var after =
+                SheetInterpreterAudio.scheduledTones(
+                        changed, SheetInterpreterAudio.SAMPLE_RATE * 12L);
+        assertEquals(before, after);
+    }
+}
