+package com.musicsheets.app.pdf;
+
+import com.musicsheets.app.playback.*;
+import com.musicsheets.app.data.SheetEffectsPreferences;
+import com.google.gson.JsonObject;
+import java.lang.reflect.*;
+import java.util.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Actual desktop preparation factory with original page DTOs, without media/model/device execution. */
+public class NativeTremoloFactoryTest {
+    private static void set(String name, Object value) throws Exception {
+        var field = NativeAudioTrack.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(null, value);
+    }
+
+    private ScorePageInterpretation page() {
+        var notes =
+                List.of(
+                        new ScoreNoteEvent(0, .15f, 0, 0, 1, .4f, false, 0, 0, 0, 2)
+                                .withClef(ScoreNoteEvent.CLEF_TREBLE),
+                        new ScoreNoteEvent(0, .65f, 4, 0, 1, .4f, false, 0, 0, 0, 2)
+                                .withClef(ScoreNoteEvent.CLEF_TREBLE));
+        var pair =
+                new ScoreTremoloSource.Pair(
+                        "native-original-pair",
+                        List.of(new ScoreTremoloSource.Anchor(0, 0)),
+                        List.of(new ScoreTremoloSource.Anchor(0, 1)),
+                        3,
+                        List.of(new ScoreTremoloSource.Evidence(0, .2f, .3f, .6f, .4f)));
+        return new ScorePageInterpretation(List.of(new MeasureRegion(0, 1, 0, 1)), notes)
+                .withTremoloSource(ScoreTremoloSource.capture(0, 2, List.of(pair)));
+    }
+
+    private SheetInterpreterAudio.RenderSpec prepare(boolean retained) throws Exception {
+        var song = new JsonObject();
+        song.addProperty("bpm", 120);
+        song.addProperty("time_signature", "4/4");
+        song.addProperty("instrument", "Piano");
+        song.addProperty("key", "C Major");
+        set("song", song);
+        set("settings", new JsonObject());
+        set("id", "original-test");
+        set("retained", retained ? page() : null);
+        set("retainedPlacements", Map.of());
+        set("retainedBoundaries", ScoreBoundaryClock.legacy());
+        set("retainedOpeningNominal", 4f);
+        set("retainedExactBoundary", null);
+        set("retainedRestOccurrences", Set.of());
+        var method =
+                NativeAudioTrack.class.getDeclaredMethod(
+                        "prepare",
+                        List.class,
+                        int[].class,
+                        int[].class,
+                        ScorePageTimeline.PageRange.class,
+                        SheetEffectsPreferences.Settings.class);
+        method.setAccessible(true);
+        try {
+            return (SheetInterpreterAudio.RenderSpec)
+                    method.invoke(
+                            null,
+                            List.of(page()),
+                            new int[] {1},
+                            new int[] {1},
+                            new ScorePageTimeline.PageRange(0, 1),
+                            SheetEffectsPreferences.Settings.defaults());
+        } catch (InvocationTargetException error) {
+            throw (Exception) error.getCause();
+        }
+    }
+
+    private int attacks(SheetInterpreterAudio.RenderSpec spec) throws Exception {
+        var method =
+                SheetInterpreterAudio.class.getDeclaredMethod(
+                        "scheduledTones", SheetInterpreterAudio.RenderSpec.class, long.class);
+        method.setAccessible(true);
+        var rate = SheetInterpreterAudio.class.getDeclaredField("SAMPLE_RATE");
+        rate.setAccessible(true);
+        return ((List<?>) method.invoke(null, spec, rate.getInt(null) * 4L)).size();
+    }
+
+    @Test
+    public void rawPageFactoryRetainsItsSourcePair() throws Exception {
+        var result = prepare(false);
+        assertEquals(1, result.tremoloSource().pairs().size());
+        assertEquals(12, attacks(result));
+    }
+
+    @Test
+    public void retainedFactoryRetainsItsSourcePair() throws Exception {
+        var result = prepare(true);
+        assertEquals(1, result.tremoloSource().pairs().size());
+        assertEquals(12, attacks(result));
+    }
+}
