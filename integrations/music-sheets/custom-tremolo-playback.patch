+                        "prepare",
+                        List.class,
+                        int[].class,
+                        int[].class,
+                        ScorePageTimeline.PageRange.class,
+                        SheetEffectsPreferences.Settings.class);
+        method.setAccessible(true);
+        try {
+            return (SheetInterpreterAudio.RenderSpec)
+                    method.invoke(
+                            null,
+                            pages,
+                            new int[] {1, 1, 1},
+                            new int[] {1, 2, 3},
+                            new ScorePageTimeline.PageRange(1, 3),
+                            SheetEffectsPreferences.Settings.defaults());
+        } catch (InvocationTargetException error) {
+            if (error.getCause() instanceof Exception e) throw e;
+            throw error;
+        }
+    }
+
+    static int attacks(SheetInterpreterAudio.RenderSpec spec) throws Exception {
+        Method method =
+                SheetInterpreterAudio.class.getDeclaredMethod(
+                        "scheduledTones", SheetInterpreterAudio.RenderSpec.class, long.class);
+        method.setAccessible(true);
+        Field rate = SheetInterpreterAudio.class.getDeclaredField("SAMPLE_RATE");
+        rate.setAccessible(true);
+        return ((List<?>) method.invoke(null, spec, rate.getInt(null) * 8L)).size();
+    }
+
+    static void check(boolean retained) throws Exception {
+        var result = prepare(retained);
+        assertEquals(4, result.notes().size());
+        assertEquals(2, result.tremoloSource().pairs().size());
+        assertEquals(24, attacks(result));
+        assertEquals(
+                List.of(1, 1, 2, 2),
+                result.tremoloSource().noteOrigins().stream()
+                        .map(o -> o.orElseThrow().pageIndex())
+                        .toList());
+        assertTrue(
+                result.tremoloSource().pairs().stream()
+                        .noneMatch(p -> p.id().equals("review-native-page-0")));
+    }
+
+    @Test
+    public void rawSelectedRangeJoinsOnlyItsActualPageOrder() throws Exception {
+        check(false);
+    }
+
+    @Test
+    public void retainedSelectedRangeKeepsItsActualJoinedDomain() throws Exception {
+        check(true);
+    }
